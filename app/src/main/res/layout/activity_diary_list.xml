<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_w"
    tools:context=".DiaryListActivity">

    <TextView
        android:id="@+id/txtMainTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/dangdang"
        android:text="내 일기 보기"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dateActionRow"
        android:layout_width="347dp"
        android:layout_height="70dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtMainTitle">

        <TextView
            android:id="@+id/txtCurrentDate"
            android:layout_width="105dp"
            android:layout_height="45dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/edittext_box"
            android:elevation="1dp"
            android:fontFamily="@font/danjunghea"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnSelectDelete"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.64"
            tools:text="5월 19일 (화)" />

        <ImageButton
            android:id="@+id/btnSelectDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/icon_button_bg"
            android:contentDescription="선택 삭제"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/select_delete"
            tools:layout_editor_absoluteX="179dp"
            tools:layout_editor_absoluteY="21dp" />

        <ImageButton
            android:id="@+id/btnDeleteAll"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="80dp"
            android:background="@drawable/icon_button_bg"
            android:contentDescription="모두 삭제"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.7" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDiary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="22dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="88dp"
        android:scrollbarThumbVertical="@color/maincolor"
        android:scrollbarTrackVertical="@android:color/transparent"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dateActionRow"
        app:layout_constraintVertical_bias="1.0"
        tools:listitem="@layout/item_diary" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddDiary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="add diary"
        android:src="@drawable/upward"
        app:backgroundTint="#fbeedf"
        app:elevation="6dp"
        app:fabSize="mini"
        app:layout_constraintBottom_toBottomOf="@id/recyclerDiary"
        app:layout_constraintEnd_toEndOf="@id/recyclerDiary"
        app:tint="@color/white"/>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/img_diary_health"
            android:layout_width="27dp"
            android:layout_height="26dp"
            android:contentDescription="calendar"
            android:src="@drawable/hamicon" />

        <ImageView
            android:id="@+id/img_diary_cal"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="58dp"
            android:layout_marginEnd="58dp"
            android:contentDescription="home"
            android:src="@drawable/hamcircle_w" />

        <ImageView
            android:id="@+id/img_diary_diary"
            android:layout_width="30dp"
            android:layout_height="28dp"
            android:contentDescription="diary"
            android:src="@drawable/hamicon" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
