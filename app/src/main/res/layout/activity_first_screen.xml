<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_w"
    tools:context=".FirstScreen">

    <TextView
        android:id="@+id/textview01"
        android:layout_width="290dp"
        android:layout_height="59dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="60dp"
        android:text="햄린더"
        android:fontFamily="@font/moyamoya"
        android:textColor="@color/maincolor"
        android:textSize="50sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="180dp"
        android:layout_height="26dp"
        android:layout_marginTop="8dp"
        android:textSize="15sp"
        android:textColor="@color/maincolor"
        android:text=" 햄스터와 함께하는 삶"
        android:fontFamily="@font/simplehea"
        app:layout_constraintStart_toStartOf="@+id/textview01"
        app:layout_constraintTop_toBottomOf="@+id/textview01" />

    <Button
        android:id="@+id/login"
        android:layout_width="201dp"
        android:layout_height="46dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_orange_rounded"
        android:fontFamily="@font/dangdang"
        android:text="로그인"
        android:textColor="@color/white"
        app:backgroundTint="@color/maincolor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView6" />

    <Button
        android:id="@+id/join"
        android:layout_width="121dp"
        android:layout_height="33dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_button_orange_rounded"
        android:fontFamily="@font/dangdang"
        android:text="회원가입"
        android:textColor="@color/white"
        android:textSize="10dp"
        app:backgroundTint="@color/maincolor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login" />

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="270dp"
        android:layout_height="270dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="184dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/hiham" />

    <TextView
        android:id="@+id/register_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/dangdang"
        android:gravity="center"
        android:text="길을 잃으셨나요?"
        android:textSize="9dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/join" />

</androidx.constraintlayout.widget.ConstraintLayout>
