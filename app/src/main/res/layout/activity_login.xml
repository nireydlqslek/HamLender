<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_w"
    tools:context=".LoginActivity">

    <TextView
        android:id="@+id/textview01"
        android:layout_width="200dp"
        android:layout_height="68dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/moyamoya"
        android:text="햄린더"
        android:textColor="@color/maincolor"
        android:textSize="40sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView01"
        android:layout_width="304dp"
        android:layout_height="292dp"
        android:contentDescription="hamster"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textview01"
        app:srcCompat="@drawable/hamcircle_w" />

    <TextView
        android:id="@+id/id_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="ID"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView01" />

    <EditText
        android:id="@+id/logintext"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/edittext_box"
        android:ems="10"
        android:inputType="textEmailAddress"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/id_textView" />

    <TextView
        android:id="@+id/pw_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="PW"
        app:layout_constraintStart_toStartOf="@id/id_textView"
        app:layout_constraintTop_toBottomOf="@id/logintext" />

    <EditText
        android:id="@+id/passwordtext"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/edittext_box"
        android:ems="10"
        android:inputType="textPassword"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pw_textView" />

    <TextView
        android:id="@+id/register_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/simplehea"
        android:text="회원가입 하러가기"
        android:textColor="@color/maincolor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/passwordtext" />

    <!-- =============================================================
         🌟 핵심 변경: 아이디 찾기 / 비밀번호 찾기 영역 레이아웃 세트
         ============================================================= -->

    <!-- [1] 아이디 찾기 텍스트 -->
    <TextView
        android:id="@+id/findId_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/simplehea"
        android:text="아이디 찾기"
        android:textColor="@color/ham_light_brown"
        android:textSize="14sp"
        android:padding="4dp"
        app:layout_constraintEnd_toStartOf="@id/find_divider"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/register_textView" />

    <!-- [2] 중간 구분선 기호 (|) -->
    <TextView
        android:id="@+id/find_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="|"
        android:textColor="@color/ham_vrlight_brown"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/findId_textView"
        app:layout_constraintEnd_toStartOf="@id/findPw_textView"
        app:layout_constraintStart_toEndOf="@id/findId_textView"
        app:layout_constraintTop_toTopOf="@id/findId_textView" />

    <!-- [3] 비밀번호 찾기 텍스트 -->
    <TextView
        android:id="@+id/findPw_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/simplehea"
        android:text="비밀번호 찾기"
        android:textColor="@color/ham_light_brown"
        android:textSize="14sp"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="@id/findId_textView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/find_divider"
        app:layout_constraintTop_toTopOf="@id/findId_textView" />

    <!-- ============================================================= -->

    <!-- 로그인 버튼 (기존 마진 88dp가 찾기 메뉴 밑으로 오도록 정렬 최적화!) -->
    <Button
        android:id="@+id/loginbutton"
        android:layout_width="168dp"
        android:layout_height="49dp"
        android:layout_marginTop="36dp"
        android:backgroundTint="@color/maincolor"
        android:fontFamily="@font/dangdang"
        android:text="로그인"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/findId_textView" />

</androidx.constraintlayout.widget.ConstraintLayout>