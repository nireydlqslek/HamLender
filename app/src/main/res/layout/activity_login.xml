<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_w"
    tools:context=".LoginActivity">

    <!-- 1. 타이틀 -->
    <TextView
        android:id="@+id/textview01"
        android:layout_width="200dp"
        android:layout_height="68dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/moyamoya"
        android:text="햄린더"
        android:textColor="@color/maincolor"
        android:textSize="40sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. 햄스터 아이콘 -->
    <ImageView
        android:id="@+id/imageView01"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:contentDescription="hamster"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textview01"
        app:srcCompat="@drawable/hamcircle_w" />

    <!-- 3. 아이콘 밑에 곧바로 배치되는 ID 텍스트 -->
    <TextView
        android:id="@+id/id_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:text="ID"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView01" />

    <!-- 4. ID 입력창 -->
    <EditText
        android:id="@+id/logintext"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/edittext_box"
        android:ems="10"
        android:inputType="textEmailAddress"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/id_textView" />

    <!-- 5. PW 텍스트 -->
    <TextView
        android:id="@+id/pw_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="PW"
        app:layout_constraintStart_toStartOf="@id/id_textView"
        app:layout_constraintTop_toBottomOf="@id/logintext" />

    <!-- 6. PW 입력창 -->
    <EditText
        android:id="@+id/passwordtext"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/edittext_box"
        android:ems="10"
        android:inputType="textPassword"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pw_textView" />

    <!-- 7. 로그인 버튼 -->
    <Button
        android:id="@+id/loginbutton"
        android:layout_width="168dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_orange_rounded"
        android:fontFamily="@font/dangdang"
        android:text="로그인"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:backgroundTint="@color/maincolor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/findId_textView" />

    <!-- 8. 정중앙에 위치할 회원가입 하러가기 -->
    <TextView
        android:id="@+id/register_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/simplehea"
        android:padding="8dp"
        android:text="회원가입 하러가기"
        android:textColor="@color/maincolor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/passwordtext" />

    <!-- 9. 최하단: 회원가입 하러가기 밑에 중앙 정렬로 배치되는 아이디/비밀번호 찾기 -->
    <TextView
        android:id="@+id/findId_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/simplehea"
        android:padding="4dp"
        android:text="아이디 찾기"
        android:textColor="@color/ham_light_brown"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/findDivider"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/register_textView" />

    <TextView
        android:id="@+id/findDivider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="|"
        android:textColor="@color/ham_vrlight_brown"
        app:layout_constraintBottom_toBottomOf="@id/findId_textView"
        app:layout_constraintEnd_toStartOf="@id/findPw_textView"
        app:layout_constraintStart_toEndOf="@id/findId_textView"
        app:layout_constraintTop_toTopOf="@id/findId_textView" />

    <TextView
        android:id="@+id/findPw_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/simplehea"
        android:padding="4dp"
        android:text="비밀번호 찾기"
        android:textColor="@color/ham_light_brown"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/findId_textView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/findDivider"
        app:layout_constraintTop_toTopOf="@id/findId_textView" />

</androidx.constraintlayout.widget.ConstraintLayout>