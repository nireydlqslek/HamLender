<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ham_background"
    tools:context=".SettingActivity">

    <TextView
        android:id="@+id/txtSettingTitle"
        android:layout_width="66dp"
        android:layout_height="51dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="76dp"
        android:fontFamily="@font/simplehea"
        android:text="설정"
        android:textColor="@color/black"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/settingContainer"
        android:layout_width="362dp"
        android:layout_height="466dp"
        android:layout_margin="20dp"
        android:background="@drawable/calendar_border"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnLogout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.486"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSettingTitle"
        app:layout_constraintVertical_bias="1.0"
        android:fontFamily="@font/simplehea">

        <!-- 내 정보 열람 -->
        <TextView
            android:id="@+id/btnMyInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="내 정보 열람"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- 푸시 알림 설정 -->
        <TextView
            android:id="@+id/btnPush"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="푸시 알림 설정"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- 카테고리 편집 -->
        <TextView
            android:id="@+id/btnCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="카테고리 편집"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- 햄햄의 보고서 설정 -->
        <RelativeLayout
            android:id="@+id/btnReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerInParent="true"
                android:text="AI ON/OFF"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                app:thumbTint="@color/maincolor"
                app:trackTint="@color/green_w" />
        </RelativeLayout>

        <!-- 건강목록 편집 -->
        <TextView
            android:id="@+id/btnHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="건강목록 편집"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- 친구 관리 -->
        <TextView
            android:id="@+id/btnFriend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="친구 관리"
            android:textColor="@color/black"
            android:textSize="16sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnLogout"
        android:layout_width="106dp"
        android:layout_height="42dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/simplehea"
        android:gravity="center"
        android:text="로그아웃"
        android:textColor="@color/black"
        android:textSize="15dp"
        app:layout_constraintBottom_toTopOf="@id/btnDeleteAccount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/btnDeleteAccount"
        android:layout_width="80dp"
        android:layout_height="34dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="40dp"
        android:fontFamily="@font/simplehea"
        android:gravity="center"
        android:text="탈퇴하기"
        android:textColor="#FF4B4B"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/back_icon"
        android:layout_width="46dp"
        android:layout_height="51dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="340dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/arrow_back_24px"
        app:tint="@color/green_w" />


</androidx.constraintlayout.widget.ConstraintLayout>