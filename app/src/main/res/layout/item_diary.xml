<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:animateLayoutChanges="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/calendar_border"
    android:elevation="2dp"
    android:minHeight="100dp"
    android:orientation="horizontal"
    android:padding="14dp">

    <CheckBox
        android:id="@+id/checkDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="10dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtDiaryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/danjunghea"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="5월 19일 (화)" />

        <TextView
            android:id="@+id/txtDiaryPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/simplehea"
            android:maxLines="3"
            android:textColor="@color/black"
            android:textSize="13sp"
            tools:text="오늘 쓴 일기 내용 미리보기입니다. 세 줄까지만 보이고 나머지는 줄임 처리됩니다." />
    </LinearLayout>

</LinearLayout>