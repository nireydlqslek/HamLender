<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_margin="16dp"
    android:background="@drawable/bg_dialog_rounded">

    <!-- 선택한 날짜 -->
    <TextView
        android:id="@+id/tvDialogDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black" />

    <!-- 등록된 일정들이 추가될 빈 공간 -->
    <LinearLayout
        android:id="@+id/layoutScheduleList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="210dp"
        android:orientation="vertical"
        android:layout_marginTop="16dp" />

    <!-- 🌟 일반 Button에서 AppCompatButton으로 전면 교체! 이제 색깔과 배경이 동시에 완벽 적용됩니다! -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAddSchedule"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_schedule_add"
        android:backgroundTint="@color/maincolor"
        android:text="+ 일정 추가"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        android:elevation="0dp" />
    <!-- 일정 입력 폼 -->
    <LinearLayout
        android:id="@+id/layoutInputForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/layoutCategoryChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <!-- 카테고리 입력 -->
        <EditText
            android:id="@+id/etCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#F5F5F5"
            android:hint="카테고리"
            android:textSize="14sp" />

        <!-- 일정 제목 입력 -->
        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#F5F5F5"
            android:hint="일정"
            android:textSize="14sp" />

        <!-- 메모 입력 -->
        <EditText
            android:id="@+id/etMemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#F5F5F5"
            android:hint="메모 작성"
            android:lines="3"
            android:gravity="top"
            android:textSize="14sp" />

        <!-- 저장 버튼 -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:text="저장하기"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/maincolor" />
    </LinearLayout>
</LinearLayout>