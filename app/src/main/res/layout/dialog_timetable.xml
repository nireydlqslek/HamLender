<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="@drawable/bg_round_dialog"

    android:padding="12dp">

    <!-- 상단 닫기 버튼 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="end|center_vertical"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnCloseTimeTable"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/close_24px"
            android:contentDescription="닫기" />
    </LinearLayout>

    <!-- 색상 선택 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/colorRed"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="빨강"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/house" />

        <ImageButton
            android:id="@+id/colorOrange"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="주황"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/hamhead" />

        <ImageButton
            android:id="@+id/colorGreen"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="초록"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/bush" />

        <ImageButton
            android:id="@+id/colorBlue"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="파랑"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/cloud" />

        <Button
            android:id="@+id/btnEditLabelTimeTable"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="라벨" />

        <Button
            android:id="@+id/btnUndoTimeTable"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="↶" />

        <Button
            android:id="@+id/btnClearAllTimeTable"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="⌫" />
    </LinearLayout>

    <!-- 큰 타임테이블 -->
    <com.example.hamlendar.TimeTable
        android:id="@+id/bigTimeTable"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp" />

</LinearLayout>