<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ham_background"
    android:fillViewport="true"
    tools:context=".RegisterActivity"> <!-- RegisterActivity 로 텍스트 매핑 수정 -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="40dp"
        android:paddingTop="24dp"
        android:paddingEnd="40dp"
        android:paddingBottom="24dp">

        <!-- [1] 타이틀 -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/moyamoya"
            android:text="햄린더"
            android:textColor="@color/maincolor"
            android:textSize="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/profileFrame"
            android:layout_width="150dp"
            android:layout_height="170dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/profile_border"
            android:padding="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="12dp"
                app:cardPreventCornerOverlap="false" >

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/hampic" />

            </androidx.cardview.widget.CardView>
    </FrameLayout>

        <!-- [3] 이름 레이블 -->
        <TextView
            android:id="@+id/tv_name_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/danjunghea"
            android:text="이름"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/profileFrame"
            app:layout_constraintTop_toTopOf="@id/profileFrame" />

        <!-- [4] 이름 입력창 -->
        <EditText
            android:id="@+id/et_name"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/calendar_border"
            android:inputType="textPersonName"
            android:paddingStart="12dp"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_name_label"
            app:layout_constraintTop_toBottomOf="@id/tv_name_label" />

        <!-- [5] 전화번호 레이블 -->
        <TextView
            android:id="@+id/tv_phone_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/danjunghea"
            android:text="전화번호"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/et_name"
            app:layout_constraintTop_toBottomOf="@id/et_name" />

        <!-- [6] 전화번호 입력창 -->
        <EditText
            android:id="@+id/et_phone"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/calendar_border"
            android:inputType="phone"
            android:paddingStart="12dp"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_phone_label"
            app:layout_constraintTop_toBottomOf="@id/tv_phone_label" />

        <!-- [7] 생일 레이블 -->
        <TextView
            android:id="@+id/tv_birth_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/danjunghea"
            android:text="생일 (EX: 2026.06.01)"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@+id/et_phone"
            app:layout_constraintTop_toBottomOf="@+id/et_phone" />

        <!-- [8] 생일 입력창 (아래로 당겨지던 오류 조건 완벽 제거!) -->
        <EditText
            android:id="@+id/et_birth"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/calendar_border"
            android:inputType="date"
            android:paddingStart="12dp"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_birth_label"
            app:layout_constraintTop_toBottomOf="@id/tv_birth_label" />

        <!-- [9] 별명 레이블 (프로필 프레임 밑이 아니라, 생일 입력창 밑으로 안착!) -->
        <TextView
            android:id="@+id/tv_nickname_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/danjunghea"
            android:text="별명"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profileFrame" />

        <!-- [10] 별명 입력창 -->
        <EditText
            android:id="@+id/et_nickname"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/calendar_border"
            android:inputType="text"
            android:paddingStart="12dp"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_nickname_label" />

        <!-- [11] 이메일 레이블 -->
        <TextView
            android:id="@+id/tv_email_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/danjunghea"
            android:text="이메일 주소"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_nickname" />

        <!-- [12] 이메일 아이디 입력창 -->
        <EditText
            android:id="@+id/et_email"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/calendar_border"
            android:inputType="text"
            android:paddingStart="12dp"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/tv_email_at"
            app:layout_constraintHorizontal_weight="1.2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_email_label" />

        <!-- [13] 이메일 @ 기호 (누락되었던 text 속성 복구!) -->
        <TextView
            android:id="@+id/tv_email_at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="@"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/et_email"
            app:layout_constraintEnd_toStartOf="@id/spinner_email_domain"
            app:layout_constraintStart_toEndOf="@id/et_email"
            app:layout_constraintTop_toTopOf="@id/et_email" />

        <!-- [14] 이메일 도메인 스피너 -->
        <Spinner
            android:id="@+id/spinner_email_domain"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:background="@drawable/calendar_border"
            android:paddingStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/tv_email_at"
            app:layout_constraintTop_toTopOf="@id/et_email" />

        <!-- [15] 비밀번호 레이블 -->
        <TextView
            android:id="@+id/tv_password_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/danjunghea"
            android:text="비밀번호"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_email" />

        <!-- [16] 비밀번호 입력창 -->
        <EditText
            android:id="@+id/et_password"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/calendar_border"
            android:inputType="textPassword"
            android:paddingStart="12dp"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_password_label" />

        <!-- [17] 비밀번호 확인 레이블 -->
        <TextView
            android:id="@+id/tv_password_confirm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/danjunghea"
            android:text="비밀번호 확인"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_password" />

        <!-- [18] 비밀번호 확인 입력창 -->
        <EditText
            android:id="@+id/et_password_confirm"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/calendar_border"
            android:inputType="textPassword"
            android:paddingStart="12dp"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_password_confirm_label" />

        <!-- [19] 보안 질문 레이블 -->
        <TextView
            android:id="@+id/tv_question_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/danjunghea"
            android:text="보안 질문 선정"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_password_confirm" />

        <!-- [20] 당신의 답 레이블 -->
        <TextView
            android:id="@+id/tv_answer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/danjunghea"
            android:text="당신의 답"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/et_answer"
            app:layout_constraintTop_toTopOf="@id/tv_question_title" />

        <!-- [21] 보안 질문 스피너 -->
        <Spinner
            android:id="@+id/spinner_question"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/calendar_border"
            android:paddingStart="8dp"
            app:layout_constraintEnd_toStartOf="@id/et_answer"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_question_title" />

        <!-- [22] 보안 질문 답변 입력창 -->
        <EditText
            android:id="@+id/et_answer"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:background="@drawable/calendar_border"
            android:inputType="text"
            android:paddingStart="12dp"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/spinner_question"
            app:layout_constraintTop_toTopOf="@id/spinner_question" />

        <!-- [23] 회원가입 완료 버튼 -->
        <Button
            android:id="@+id/register_btn"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/green_w"
            android:fontFamily="@font/dangdang"
            android:text="모든 정보가 입력되지 않았습니다"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_answer"
            app:layout_constraintVertical_bias="0.0"
            tools:ignore="UnusedAttribute" />

        <TextView
            android:id="@+id/gotologin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="120dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/simplehea"
            android:text="로그인 하러가기"
            android:textColor="@color/maincolor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/register_btn" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>