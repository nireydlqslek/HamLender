<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/calendar_border"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:minHeight="92dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/txtDiaryDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/dangdang"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="3월 23일 (월)" />

    <TextView
        android:id="@+id/txtDiaryPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/simplehea"
        android:lineSpacingExtra="1dp"
        android:maxLines="3"
        android:textColor="@color/black"
        android:textSize="13sp"
        tools:text="오늘은 오후 햄스터와 산책을 했다. 그리고 밥도 맛있게 먹었다. 즐거운 하루였다." />

</LinearLayout>
